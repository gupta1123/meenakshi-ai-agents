# Local Meenakshi backend configuration — do not commit .env.local
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SECRET
FRONTEND_ORIGIN=http://localhost:3000

# Keep this as mock while testing notifications locally.
MEENAKSHI_MSG91_TRANSPORT=mock
# Optional safety gate for a real-message test. When set, delivery is blocked
# unless the stored customer contact is this exact E.164 number.
MEENAKSHI_MSG91_TEST_RECIPIENT_E164=+919876543210
# MSG91_AUTHKEY=
# MSG91_WHATSAPP_NUMBER=
